APP_NAME=Smart Resume API
DEBUG=false

# 与 docker/docker-compose.yml 保持一致：postgres / postgres / smart_resume
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_resume
REDIS_URL=redis://localhost:6379/0

# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 大模型（千问 / 阿里云百炼，OpenAI 兼容协议）────────────────────────────
# 获取 API Key：https://platform.qianwenai.com/home/api-keys
#   · 按量付费 Key 形如 sk-ws-xxxxx；Token Plan 订阅 Key 形如 sk-sp-xxxxx
#   · 完整 Key 仅在创建时显示一次，请立即保存
# 文档：https://platform.qianwenai.com/docs/developer-guides/getting-started/introduction
#
# 注意：本项目文本与视觉共用同一个 LLM_API_BASE（见 app/services/*.py 的 _get_client），
#       因此两者必须来自同一服务端点。千问的兼容端点在同一个 base_url 下同时提供
#       文本与视觉模型，天然满足该约束。
#
# 变量名说明：此处用 LLM_API_KEY（本项目统一命名），
#             官方文档示例里的 DASHSCOPE_API_KEY 是同一个东西，不要在本项目另起一个。
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-qwen-api-key

# 文本模型：qwen3.7-plus（官方推荐，质量/速度/成本均衡）
#   更省 → qwen3.8-flash ｜ 更强 → qwen3.8-max
LLM_MODEL_TEXT=qwen3.7-plus

# 视觉模型：简历主链路为「PDF → 渲染成图 → 视觉识读」，必须是支持视觉理解的模型
#   qwen3.7-plus 同时具备视觉理解能力；专用视觉模型可选 qwen3-vl-plus
LLM_MODEL_VISION=qwen3.7-plus

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=smart-resume
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本地 OCR（可选，启用需安装 paddlepaddle + paddleocr，内存占用约 +1GB）
USE_LOCAL_OCR=false

# WeasyPrint 高保真 PDF（可选，启用需安装 weasyprint + GTK 系统库）
USE_WEASYPRINT=false

# 统一模板渲染简历 PDF（替代像素级复原），PDF 导出需 Playwright + Chromium
USE_TEMPLATE_PDF=true

# 签名 URL 域名
BACKEND_URL=http://localhost:8000

# 邮箱 SMTP 配置（用于发送验证码，不配置则打印到控制台）
# QQ邮箱配置步骤：
#   1. 登录 QQ 邮箱 → 设置 → 账户 → 开启 POP3/SMTP 服务
#   2. 生成并记录「授权码」（不是 QQ 密码本身）
#   3. 邮箱地址 @qq.com 的完整形式填到 SMTP_USER 和 SMTP_FROM
#   4. 授权码填到 SMTP_PASSWORD
# 注意：不要用真实个人邮箱硬编码进模板，复制成本文件后自行替换。
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your-email@qq.com
# 发件人显示名：收件方邮件列表里显示的名字，隐藏真实邮箱账号前缀（如「智能简历 <xxx@qq.com>」）
SMTP_FROM_NAME=智能简历

# IMAP（用于读取投递回执/回复，不配置则相关功能不可用）
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your-email@qq.com
IMAP_PASSWORD=your-imap-auth-code
IMAP_FOLDER=INBOX

# 投递功能总开关与每日限额
DELIVERY_ENABLED=false
DELIVERY_DAILY_LIMIT=20
DELIVERY_FROM_NAME=智能简历