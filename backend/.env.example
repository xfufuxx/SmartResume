# 邮箱 SMTP 配置（用于发送验证码，不配置则打印到控制台）
# QQ邮箱配置步骤：
#   1. 登录 QQ 邮箱 → 设置 → 账户 → 开启 POP3/SMTP 服务
#   2. 生成并记录「授权码」（不是 QQ 密码本身）
#   3. 邮箱地址 @qq.com 的完整形式填到 SMTP_USER 和 SMTP_FROM
#   4. 授权码填到 SMTP_PASSWORD
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=2375959600@qq.com
SMTP_PASSWORD=hvfrooeresaceaaj
